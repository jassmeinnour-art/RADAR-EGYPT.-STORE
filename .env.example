# Merchant Radar Egypt (رادار التاجر الذكي) - Multi-Merchant Environment Variables
NODE_ENV=production
PORT=3000

# Supabase Multi-Tenant Database & Auth
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini AI Key
VITE_GEMINI_API_KEY=your-gemini-api-key

# Amazon SP-API Production App Credentials
AMAZON_CLIENT_ID=your-amazon-lwa-client-id
VITE_AMAZON_CLIENT_ID=your-amazon-lwa-client-id
AMAZON_CLIENT_SECRET=your-amazon-lwa-client-secret
AMAZON_APP_ID=your-amazon-sp-api-application-id
AMAZON_MARKETPLACE_ID=ARBP9OOSHTCHU
AMAZON_REGION=eu-west-1

