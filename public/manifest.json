  "categories": [
    "business",
    "shopping",
    "productivity",
    "finance"
  ],
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "browser"
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "file_handlers": [
    {
      "action": "/?import=catalog",
      "name": "سجل أسعار وكتالوج المنتجات",
      "accept": {
        "text/csv": [".csv"],
        "application/vnd.ms-excel": [".xls"],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"]
      },
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+radar",
      "url": "/?product_link=%s"
    },
    {
      "protocol": "web+bayyaa",
      "url": "/?merchant_id=%s"
    }
  ],
  "scope_extensions": [
    {
      "origin": "https://radaregypt.store"
    },
    {
      "origin": "*.bayyaa.eg"
    }
  ],
  "share_target": {
    "action": "/?share=true",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.merchantradaregy.app",
      "id": "com.merchantradaregy.app"
    },
    {
      "platform": "webapp",
      "url": "https://radaregypt.store/manifest.json"
    }
  ],
  "prefer_related_applications": false
}
