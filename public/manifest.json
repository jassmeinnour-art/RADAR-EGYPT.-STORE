{
  "id": "/",
  "name": "رادار التاجر الذكي | Merchant Radar & Bayyaa",
  "short_name": "رادار التاجر",
  "description": "منصة ذكية لمتابعة السلع والأسعار والمنافسة وتحليل الأسواق في مصر مع ربط مباشر لمنصة بياع وأمازون ونون",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "tabbed",
    "standalone",
    "window-controls-overlay"
  ],
  "orientation": "any",
  "background_color": "#0F2A4A",
  "theme_color": "#FF6B00",
  "dir": "rtl",
  "lang": "ar-EG",
  "iarc_rating_id": "PEGI 3",
  "note_taking": {
    "new_note_url": "/?action=new_note"
  },
  "widgets": [
    {
      "name": "مؤشر أسعار رادار التاجر",
      "short_name": "رادار الأسعار",
      "description": "قطعة ذكية لعرض تحديثات ومؤشرات أداء وتغيرات أسعار السوق المصري في الوقت الفعلي",
      "tag": "radar-price-tracker",
      "template": "radar-widget-template",
      "ms_ac_template": "/widgets/price-tracker.json",
      "data": "/api/widget-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/pwa-512x512.png",
          "sizes": "512x512",
          "type": "image/png",
          "label": "معاينة القطعة الذكية لمراقبة الأسعار"
        }
      ],
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "auth": false,
      "update_interval": 3600
    }
  ],
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "https://www.pwabuilder.com/assets/icons/icon_192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "https://www.pwabuilder.com/assets/icons/icon_512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot.jpg",
      "sizes": "1280x720",
      "type": "image/jpeg",
      "form_factor": "wide",
      "platform": "wide",
      "label": "رادار التاجر الذكي - لوحة القيادة وتحليل الأسواق"
    },
    {
      "src": "/screenshots/desktop-1280x720.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "رادار التاجر الذكي - مراقبة أسعار المنافسين"
    },
    {
      "src": "/screenshots/mobile-720x1280.png",
      "sizes": "720x1280",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "رادار التاجر الذكي على الموبايل"
    }
  ],
  "shortcuts": [
    {
      "name": "لوحة التحكم الرئيسية",
      "short_name": "الرئيسية",
      "description": "الانتقال المباشر إلى لوحة قيادة رادار التاجر",
      "url": "/?action=dashboard",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "تسجيل الدخول / الحساب",
      "short_name": "دخول",
      "description": "تسجيل الدخول الحساب أو إدارة الاشتراك",
      "url": "/?action=login",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "كتالوج المنتجات والأسعار",
      "short_name": "المنتجات",
      "description": "استعراض ومتابعة قائمة المنتجات والأسعار",
      "url": "/?action=products",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "البحث الفوري عن منتج",
      "short_name": "بحث",
      "description": "ابحث عن أي منتج في السوق المصري",
      "url": "/?action=search",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "شبكة عروض الموردين",
      "short_name": "الموردين",
      "description": "عروض خامات ومصانع الأثاث والجملة",
      "url": "/?action=suppliers",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "categories": [
    "business",
    "shopping",
    "productivity",
    "finance"
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "file_handlers": [
    {
      "action": "/?import=catalog",
      "name": "سجل أسعار وكتالوج المنتجات",
      "accept": {
        "text/csv": [".csv"],
        "application/vnd.ms-excel": [".xls"],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"]
      },
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "action": "/open-pdf",
      "name": "مستندات وبيانات المنتجات PDF",
      "accept": {
        "application/pdf": [".pdf"]
      },
      "icons": [
        {
          "src": "/pdf-icon.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    },
    {
      "action": "/show-model",
      "name": "نماذج المنتجات ثلاثية الأبعاد",
      "accept": {
        "application/sla": [".stl"],
        "application/octet-stream": [".fbx"]
      },
      "icons": [
        {
          "src": "/3d-printer-icon.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "multiple-clients"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+radar",
      "url": "/?product_link=%s"
    },
    {
      "protocol": "web+bayyaa",
      "url": "/?merchant_id=%s"
    }
  ],
  "scope_extensions": [
    {
      "origin": "https://radaregypt.store"
    },
    {
      "origin": "*.bayyaa.eg"
    },
    {
      "origin": "*.radaregypt.store"
    }
  ],
  "share_target": {
    "action": "/collect-files",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "lists",
          "accept": ["text/csv", ".csv", "application/pdf", ".pdf"]
        }
      ]
    }
  },
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.merchantradaregy.app",
      "id": "radaregypt.store"
    },
    {
      "platform": "webapp",
      "url": "https://radaregypt.store/manifest.json",
      "id": "radaregypt.store"
    },
    {
      "platform": "windows",
      "url": "https://radaregypt.store/",
      "id": "radaregypt.store"
    },
    {
      "platform": "chrome_web_store",
      "url": "https://radaregypt.store/",
      "id": "radaregypt.store"
    },
    {
      "platform": "amazon",
      "url": "https://radaregypt.store/",
      "id": "radaregypt.store"
    },
    {
      "platform": "itunes",
      "url": "https://radaregypt.store/",
      "id": "radaregypt.store"
    },
    {
      "platform": "f-droid",
      "url": "https://radaregypt.store/",
      "id": "radaregypt.store"
    }
  ],
  "prefer_related_applications": false
}
